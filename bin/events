#!/usr/bin/env node

require('dotenv').config({path: `${__dirname}/../.env`});

const Promise = require('bluebird');
const cli = require('@vbarbarosh/node-helpers/src/cli');
const perf_end_human = require('@vbarbarosh/node-helpers/src/perf_end_human');
const perf_start = require('@vbarbarosh/node-helpers/src/perf_start');

cli(main);

async function main()
{
    let _resolve;

    const ws = new WebSocket('ws://127.0.0.1:3000/api/v1/events', {
        headers: {Authorization: `Bearer ${process.env.PAT}`},
    });
    const p = new Promise(resolve => _resolve = resolve);

    ws.onopen = function (event) {
        console.log('[onopen]', event);
    };

    ws.onclose = function (event) {
        console.log('[onclose]', event);
        _resolve();
    };

    ws.onmessage = function (event) {
        console.log('[onmessage]', event.data, event);
    };

    await p;

    console.log('bye');
}
